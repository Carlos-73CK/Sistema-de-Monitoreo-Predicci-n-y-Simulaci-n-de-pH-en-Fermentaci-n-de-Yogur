# ==============================================================================
# PrediYogur Backend — Variables de Entorno de Referencia (.env.example)
# Proyecto Universitario ULEAM — Monitoreo, Predicción y Simulación de pH
# IMPORTANTE: Copie este archivo a `backend/.env` y configure su credencial real
# rotada de Neon PostgreSQL. NUNCA publique `backend/.env` en el repositorio.
# ==============================================================================

# Puerto de escucha del servidor Express
PORT=5000
NODE_ENV=development

# ==============================================================================
# Conexión Central a Neon PostgreSQL (Pooler + SSL Obligatorio)
# Proveedor: Neon | Motor: PostgreSQL | Base de datos: neondb
# Host de referencia: ep-small-salad-bdlzp55d-pooler.c-8.us-east-2.aws.neon.tech
# Usuario de referencia: neondb_owner | Puerto: 5432
# ==============================================================================
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST/BASE_DE_DATOS?sslmode=require
DB_SSL=true
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# Variables individuales opcionales de respaldo (si no se define DATABASE_URL)
DB_HOST=ep-small-salad-bdlzp55d-pooler.c-8.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=REEMPLAZAR_CON_CONTRASENA_ROTADA_EN_ARCHIVO_ENV_LOCAL

# ==============================================================================
# Seguridad y Autenticación JWT
# ==============================================================================
JWT_SECRET=prediyogur_super_secret_key_2026
JWT_EXPIRES_IN=7d
