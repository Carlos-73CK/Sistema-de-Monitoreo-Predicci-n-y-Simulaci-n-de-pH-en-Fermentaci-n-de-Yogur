# ==============================================================================
# PrediYogur Backend - Variables de Entorno de Ejemplo
# Proyecto ULEAM - Sistema de Monitoreo, Predicción y Simulación de pH
# ==============================================================================

# Puerto de escucha del servidor Express
PORT=5000

# Conexión a la Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prediyogur_db
DB_USER=postgres
DB_PASSWORD=secret

# Clave secreta y tiempo de expiración para tokens JWT
JWT_SECRET=prediyogur_super_secret_key_2026
JWT_EXPIRES_IN=7d
