as. Rompen grasas y saponifican l\xedpidos.'},{id:8,nombre:'\ud83e\uddea Lej\xeda / Lavandina',ph:'pH 12.0 \u2013 13.0',color:'#9333EA',bg:'#F3E8FF',tipo:'Alcalino Fuerte',desc:'Agentes desinfectantes de laboratorio para mesas y pipetas.'}],h=u[l]||u[3];return(0,s.jsxs)(r.ScrollView,{style:n.screen,contentContainerStyle:n.content,showsVerticalScrollIndicator:!1,children:[(0,s.jsxs)(r.View,{style:n.header,children:[(0,s.jsx)(r.Text,{style:n.eyebrow,children:"Facultad de Ciencias de la Vida \u2014 ULEAM"}),(0,s.jsx)(r.Text,{style:n.title,children:"Bioqu\xedmica & Escala de pH"}),(0,s.jsx)(r.Text,{style:n.subtitle,children:"Fundamentos biof\xedsicos y metab\xf3licos de la fermentaci\xf3n l\xe1ctea explicados por el Dr. Stalin Santacruz Ter\xe1n en c\xe1tedra."})]}),(0,s.jsxs)(r.View,{style:n.card,children:[(0,s.jsx)(r.Text,{style:n.cardTitle,children:"\ud83d\udd2c Las 3 Etapas Bioqu\xedmicas de la Fermentaci\xf3n"}),(0,s.jsxs)(r.Text,{style:n.cardSubtitle,children:["Metabolismo de bacterias de Chiver\xeda (",(0,s.jsx)("em",{children:"Lactobacillus bulgaricus"})," y ",(0,s.jsx)("em",{children:"Streptococcus thermophilus"}),"):"]}),(0,s.jsxs)(r.View,{style:n.etapasList,children:[(0,s.jsxs)(r.View,{style:[n.etapaBox,{borderLeftColor:'#0284C7'}],children:[(0,s.jsx)(r.Text,{style:[n.etapaTitle,{color:'#0369A1'}],children:"1. Hidr\xf3lisis de Carbohidratos (Disac\xe1ridos)"}),(0,s.jsx)(r.Text,{style:n.etapaTexto,children:"Las bacterias hidrolizan enzim\xe1ticamente los az\xfacares del medio para obtener energ\xeda:"}),(0,s.jsxs)(r.View,{style:n.codeBlock,children:[(0,s.jsx)(r.Text,{style:n.codeText,children:"\ud83d\udc04 Leche de Vaca: Lactosa \u2794 Glucosa + Galactosa"}),(0,s.jsx)(r.Text,{style:n.codeText,children:"\ud83c\udf31 Leche Vegetal (Chocho/Coco): Sacarosa \u2794 Glucosa + Fructosa"})]}),(0,s.jsx)(r.Text,{style:n.etapaNota,children:"\ud83d\udca1 Audio 2 Dr. Santacruz: Si se formula con Glucosa directa en leche vegetal, se omite el paso enzim\xe1tico previo, aceler